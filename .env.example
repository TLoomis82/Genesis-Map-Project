# Copy to .env.local and paste your Mapbox public token (starts with pk.)
# Restrict the token to the site address in the Mapbox dashboard before going live.
VITE_MAPBOX_TOKEN=

# Optional, for your own machine only. Set to 1 to show material that is waiting on permission
# (files you have placed in public/land/private/). Leave it out, or set it to 0, to skip it.
# It has no effect on builds: private files are always left out of `npm run build`.
VITE_SHOW_PRIVATE=0
